root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# Google Java Format: bloco de 2 espaços, limite de coluna 100.
[*.java]
indent_size = 2
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 2

# Quebra de linha em Markdown é dois espaços no fim da linha.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf
