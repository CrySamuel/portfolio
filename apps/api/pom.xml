<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>dev.crystofer</groupId>
  <artifactId>portfolio-api</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>portfolio-api</name>
  <description>API do portfolio - Java 21, Spring Boot, arquitetura hexagonal</description>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spotless.version>3.9.0</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>

    <!-- Nao gerenciadas pelo spring-boot-dependencies; as versoes sao nossas. -->
    <mapstruct.version>1.6.3</mapstruct.version>
    <springdoc.version>2.8.6</springdoc.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      Substitui o spring-boot-starter-jdbc declarado no commit 16: o starter de
      JPA ja o traz transitivamente, e manter os dois declarados sugeriria que a
      aplicacao usa JDBC direto em algum lugar - nao usa. O DataSource de que o
      Flyway depende continua vindo daqui.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!--
      Mapeia entidade JPA para modelo de dominio em tempo de compilacao, sem
      reflection. O ganho decisivo nao e performance: e o compilador recusar o
      build quando um campo do destino fica sem origem (ver a compilerArg
      unmappedTargetPolicy, mais abaixo). Mapeamento manual erra em silencio - o
      campo novo simplesmente chega null na tela.
    -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>

    <!--
      A partir do Flyway 10 o suporte a cada banco mora em modulo proprio. So o
      flyway-core no classpath falha em tempo de execucao com "Unsupported
      Database: PostgreSQL" - erro que nao aparece na compilacao.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Gera o OpenAPI 3.1 a partir dos proprios controllers, e nao de um arquivo
      escrito a mao que envelhece em silencio. O documento resultante e o que
      alimenta o @portfolio/api-client: contrato divergente vira build quebrado,
      nao bug de producao (secao 3.8).

      O -ui traz o Swagger UI junto. Sao ~2 MB de webjar que nao pesam no
      runtime, e uma pagina navegavel vale muito para quem abre o repositorio
      para avaliar - que e um dos publicos declarados na secao 1.2.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Postgres 16 de verdade nos testes, em container descartavel. A versao vem
      do spring-boot-dependencies (testcontainers 1.21.4), entao nao ha numero a
      manter aqui.

      O spring-boot-testcontainers e o que habilita @ServiceConnection: o
      container passa a configurar datasource sozinho, sem @DynamicPropertySource
      escrito a mao.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        O processador do MapStruct roda na compilacao e gera os *Impl. Duas
        opcoes viram regra do projeto, e nao escolha de cada mapper:

        unmappedTargetPolicy=ERROR  campo do destino sem origem reprova o build.
                                    E o que transforma "esqueci de mapear" de bug
                                    de producao em erro de compilacao - o motivo
                                    de o plano escolher MapStruct (secao 4.1).

        defaultComponentModel=spring  o *Impl nasce como @Component, injetavel
                                      por construtor, sem repetir a anotacao em
                                      cada interface.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <!--
            Configurado na execucao, e nao no plugin. No nivel do plugin as
            opcoes valeriam tambem para default-testCompile, que compila fontes
            sem nenhum @Mapper: o javac recebe os -A, nao encontra processador
            que os reconheca e imprime um WARNING a cada build. Aviso recorrente
            e inofensivo e pior do que nenhum aviso - ensina a ignorar a coluna
            onde um dia aparecera um aviso que importa.
          -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>org.mapstruct</groupId>
                  <artifactId>mapstruct-processor</artifactId>
                  <version>${mapstruct.version}</version>
                </path>
              </annotationProcessorPaths>
              <compilerArgs>
                <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                <arg>-Amapstruct.defaultComponentModel=spring</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            ./mvnw spring-boot:run sobe com o perfil local. O jar empacotado nao
            carrega perfil nenhum por padrao, entao producao recebe apenas os
            defaults seguros de application.yml, mesmo que a variavel de ambiente
            SPRING_PROFILES_ACTIVE falhe.
          -->
          <profiles>
            <profile>local</profile>
          </profiles>
        </configuration>
      </plugin>

      <!--
        Equivalente do Prettier no lado Java. A formatacao deixa de ser assunto
        de revisao de PR e vira propriedade do build: 'check' esta ligado a fase
        validate, entao qualquer ./mvnw verify falha antes de compilar se houver
        arquivo fora do padrao. Para corrigir: ./mvnw spotless:apply
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <!--
              Ordem de import fixa. Sem ela, cada IDE agrupa de um jeito e o
              diff enche de ruido que nao tem relacao com a mudanca.
            -->
            <importOrder>
              <order>java,javax,jakarta,org,com,</order>
            </importOrder>
            <formatAnnotations/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
