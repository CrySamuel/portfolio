<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>dev.crystofer</groupId>
  <artifactId>portfolio-api</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>portfolio-api</name>
  <description>API do portfolio - Java 21, Spring Boot, arquitetura hexagonal</description>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spotless.version>3.9.0</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>

    <!-- Nao gerenciadas pelo spring-boot-dependencies; as versoes sao nossas. -->
    <mapstruct.version>1.6.3</mapstruct.version>
    <springdoc.version>3.1.0</springdoc.version>
    <archunit.version>1.5.0</archunit.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <wiremock.version>3.13.2</wiremock.version>
  </properties>

  <!--
    Ate o Boot 3.5 o spring-boot-dependencies gerenciava as versoes do
    Testcontainers, e declarar junit-jupiter e postgresql sem versao bastava. O
    Boot 4 deixou de gerencia-las, e o build passa a nem carregar o POM.

    A saida e o BOM do proprio Testcontainers, e nao um numero repetido em cada
    artefato: assim os modulos sobem sempre juntos. O 2.0.5 nao e escolha nossa -
    e o que o spring-boot-testcontainers 4.1.0 traz, ou seja, a combinacao contra
    a qual o Spring testou.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      Chamava-se spring-boot-starter-web ate o Boot 4. O rename acompanha a
      modularizacao da 4.0, que separou WebMvc de WebFlux em starters distintos
      em vez de decidir por presenca no classpath.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      Substitui o spring-boot-starter-jdbc declarado no commit 16: o starter de
      JPA ja o traz transitivamente, e manter os dois declarados sugeriria que a
      aplicacao usa JDBC direto em algum lugar - nao usa. O DataSource de que o
      Flyway depende continua vindo daqui.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!--
      Mapeia entidade JPA para modelo de dominio em tempo de compilacao, sem
      reflection. O ganho decisivo nao e performance: e o compilador recusar o
      build quando um campo do destino fica sem origem (ver a compilerArg
      unmappedTargetPolicy, mais abaixo). Mapeamento manual erra em silencio - o
      campo novo simplesmente chega null na tela.
    -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>

    <!--
      Starter proprio desde o Boot 4: a modularizacao da 4.0 tirou a
      autoconfiguracao do Flyway do nucleo, entao declarar so o flyway-core
      passou a nao ligar mais nada - as migracoes simplesmente nao rodam, sem
      erro de compilacao e sem aviso no boot.

      O flyway-database-postgresql continua declarado a parte por outro motivo,
      anterior a este: desde o Flyway 10 o suporte a cada banco mora em modulo
      proprio, e sem ele o boot falha com "Unsupported Database: PostgreSQL".
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Gera o OpenAPI 3.1 a partir dos proprios controllers, e nao de um arquivo
      escrito a mao que envelhece em silencio. O documento resultante e o que
      alimenta o @portfolio/api-client: contrato divergente vira build quebrado,
      nao bug de producao (secao 3.8).

      O -ui traz o Swagger UI junto. Sao ~2 MB de webjar que nao pesam no
      runtime, e uma pagina navegavel vale muito para quem abre o repositorio
      para avaliar - que e um dos publicos declarados na secao 1.2.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Duas dependencias que ate o Boot 3.5 vinham dentro do starter-test. A
      modularizacao da 4.0 as separou, e sem elas o codigo de teste nao compila -
      falha alta, que e o comportamento desejavel numa mudanca de plataforma.

      resttestclient       traz o TestRestTemplate, agora em
                           org.springframework.boot.resttestclient. E ele que
                           exercita a aplicacao por HTTP de verdade, o unico
                           nivel onde codificacao de bytes e negociacao de
                           conteudo sao observaveis (secao 13.6)

      starter-webmvc-test  traz o @WebMvcTest, o teste de fatia que isola o
                           controlador do resto da aplicacao
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      O TestRestTemplate e construido por um RestTemplateBuilder, que ate o Boot
      3.5 vinha junto do starter web e no Boot 4 mora em modulo proprio. Faltando
      ele, a autoconfiguracao nem chega a rodar: o contexto quebra no
      @ConditionalOnMissingBean com NoClassDefFoundError, uma mensagem que nao
      menciona TestRestTemplate nem RestTemplate.

      **Saiu do escopo de teste neste commit**, como o comentario anterior
      previa: o adaptador do GitHub e a primeira chamada HTTP de saida do
      sistema, e o RestClient agora e codigo de producao.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
    </dependency>

    <!--
      Cache de aplicacao (secao 3.9, nivel L2). O starter traz a abstracao -
      @EnableCaching, @Cacheable, CacheManager - e nada de implementacao; o
      Caffeine entra ao lado porque a escolha de motor e nossa.

      Caffeine e nao Redis: com uma instancia da API, cache distribuido nao
      resolve problema nenhum que exista hoje, e adiciona um servico a manter. A
      decisao esta registrada na secao 4.1 do plano e a interface e do Spring,
      entao trocar depois e trocar uma dependencia.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>

    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!--
      Disjuntor, retentativa e bulkhead (ADR-0008). O artefato ainda se chama
      spring-boot3 porque nao existe versao para o Boot 4 - a 2.3.0 e a mais
      nova publicada, e foi lancada contra o Boot 3.

      **Nao e suposicao de que funciona.** O contexto sobe, os aspectos
      interceptam e o disjuntor abre depois do limiar - as tres coisas estao
      cobertas por teste, porque anotacao que nao intercepta e a pior das
      guardas: ela documenta uma protecao que nao existe.
    -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>

    <!--
      **Sem isto o estado do circuito nao existe como metrica.** A
      autoconfiguracao do Resilience4j so registra os medidores quando este
      artefato esta no classpath, e ele nao vem junto do starter - a ausencia
      nao da erro nem aviso, e o /actuator/prometheus simplesmente nao tem
      nenhuma familia resilience4j_*.

      Medido em producao antes de entrar: 319 linhas no dump, com as metricas
      de cache do Caffeine presentes e nenhuma do disjuntor. A Definition of
      Done do MVP 4 exige as duas, e a metade que faltava era justamente a que
      permite enxergar um circuito aberto sem abrir o log da plataforma.
    -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-micrometer</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>

    <!--
      Os aspectos do Resilience4j sao AOP, e sem isto nao ha o que os teca.
      Chamava-se spring-boot-starter-aop ate o Boot 4; o rename acompanha a
      modularizacao, como aconteceu com starter-web -> starter-webmvc. A forma
      antiga nem chega a resolver: o Maven recusa o POM por falta de versao,
      porque o BOM do Boot 4 nao conhece mais aquele nome.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aspectj</artifactId>
    </dependency>

    <!--
      Publica as metricas em /actuator/prometheus - inclusive o estado do
      circuito e o hit ratio do Caffeine, que a Definition of Done do MVP 4 pede
      observaveis. Sem o registro, o Micrometer coleta e nao ha por onde ler.
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Postgres 16 de verdade nos testes, em container descartavel. As versoes
      vem do testcontainers-bom importado acima.

      O spring-boot-testcontainers e o que habilita @ServiceConnection: o
      container passa a configurar datasource sozinho, sem @DynamicPropertySource
      escrito a mao.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      O prefixo testcontainers- no artifactId chegou na 2.0: os modulos se
      chamavam junit-jupiter e postgresql, nomes genericos demais para um
      groupId compartilhado. Sem o prefixo o Maven nem le o POM, entao a
      renomeacao falha alto - que e o comportamento desejavel.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Le o bytecode de target/classes e faz das regras de dependencia da secao
      3.4 um teste. E o artefato agregador: traz a api (@AnalyzeClasses,
      @ArchTest) e o engine do JUnit 5 que executa os campos ArchRule.

      Escopo de teste de proposito. A verificacao acontece no build, entao nada
      disto vai para o jar de producao - o custo em runtime e zero.
    -->
    <!--
      Simula a API do GitHub, inclusive as falhas dela. E o que permite provar o
      disjuntor de forma deterministica: 403 de cota, 500, timeout e resposta
      malformada acontecem quando o teste manda, e nao quando o GitHub resolve.

      A versao 3 e nao a 4, que esta em beta. O artefato **standalone** traz o
      Jetty sombreado dentro dele: a aplicacao roda em Tomcat, e um Jetty solto
      no classpath de teste disputaria a autoconfiguracao de servidor do Boot.
    -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        O processador do MapStruct roda na compilacao e gera os *Impl. Duas
        opcoes viram regra do projeto, e nao escolha de cada mapper:

        unmappedTargetPolicy=ERROR  campo do destino sem origem reprova o build.
                                    E o que transforma "esqueci de mapear" de bug
                                    de producao em erro de compilacao - o motivo
                                    de o plano escolher MapStruct (secao 4.1).

        defaultComponentModel=spring  o *Impl nasce como @Component, injetavel
                                      por construtor, sem repetir a anotacao em
                                      cada interface.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <!--
            Configurado na execucao, e nao no plugin. No nivel do plugin as
            opcoes valeriam tambem para default-testCompile, que compila fontes
            sem nenhum @Mapper: o javac recebe os -A, nao encontra processador
            que os reconheca e imprime um WARNING a cada build. Aviso recorrente
            e inofensivo e pior do que nenhum aviso - ensina a ignorar a coluna
            onde um dia aparecera um aviso que importa.
          -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>org.mapstruct</groupId>
                  <artifactId>mapstruct-processor</artifactId>
                  <version>${mapstruct.version}</version>
                </path>
              </annotationProcessorPaths>
              <compilerArgs>
                <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                <arg>-Amapstruct.defaultComponentModel=spring</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            ./mvnw spring-boot:run sobe com o perfil local. O jar empacotado nao
            carrega perfil nenhum por padrao, entao producao recebe apenas os
            defaults seguros de application.yml, mesmo que a variavel de ambiente
            SPRING_PROFILES_ACTIVE falhe.
          -->
          <profiles>
            <profile>local</profile>
          </profiles>
        </configuration>
      </plugin>

      <!--
        Equivalente do Prettier no lado Java. A formatacao deixa de ser assunto
        de revisao de PR e vira propriedade do build: 'check' esta ligado a fase
        validate, entao qualquer ./mvnw verify falha antes de compilar se houver
        arquivo fora do padrao. Para corrigir: ./mvnw spotless:apply
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <!--
              Ordem de import fixa. Sem ela, cada IDE agrupa de um jeito e o
              diff enche de ruido que nao tem relacao com a mudanca.
            -->
            <importOrder>
              <order>java,javax,jakarta,org,com,</order>
            </importOrder>
            <formatAnnotations/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
