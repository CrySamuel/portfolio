# Copie para .env e ajuste. O .env nunca e versionado.
#
# Este arquivo e a documentacao das variaveis exigidas pelo projeto: variavel
# que nao aparece aqui nao deveria existir no codigo. As que ainda nao sao
# usadas estao marcadas com o commit em que passam a ser.

# ---------------------------------------------------------------------------
# Banco de dados local (infra/docker/docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

# Se ja houver um PostgreSQL instalado na maquina, ele provavelmente ocupa a
# 5432 - e a falha resultante mente. O Docker publica a porta assim mesmo, em
# outro endereco de bind, e a aplicacao conecta no servidor errado: o erro que
# aparece e "password authentication failed", nao "porta ocupada", porque o
# servidor local de fato existe e de fato nao conhece o usuario portfolio.
#
# Como confirmar, comparando as duas pontas - a do container tem de ser a 16:
#   docker exec portfolio-postgres psql -U portfolio -d portfolio -tAc "select version()"
#   psql -h 127.0.0.1 -p 5432 -U portfolio -d portfolio -tAc "select version()"
#
# Conectar na versao errada e pior do que nao conectar: a secao 4.3 do plano
# escolhe Postgres 16 em dev, teste e producao justamente para que dialeto e
# comportamento sejam os mesmos nos tres.
#
# Esta variavel precisa valer para os dois lados - o compose le do .env, mas a
# aplicacao le do ambiente do processo. Exporte-a de verdade, nao so aqui.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
# Porta do servidor. Em producao o Render injeta PORT automaticamente.
PORT=8080

# Chave compartilhada entre o BFF do Next e a API Java (ADR-0005).
# Gere com: openssl rand -base64 32
#
# EXIGIDA DOS DOIS LADOS, e nenhum dos dois sobe sem ela: a API recusa o boot
# (SecurityConfig) e o web recusa na validacao de ambiente (lib/env.ts). Sem essa
# recusa, esquece-la no painel do Render publicaria a API aberta na internet sem
# que nada avisasse - e o sintoma seria ausencia de sintoma.
#
# Minimo de 32 caracteres nas duas pontas, que e o que o comando acima gera.
#
# O valor abaixo vale so para desenvolvimento: e o mesmo default de
# application-local.yml, e por isso a API local aceita o web local sem nenhuma
# configuracao. Producao usa uma chave gerada, que nunca sai do painel.
SERVICE_API_KEY=chave-local-de-desenvolvimento-nao-use-em-producao

# Token do GitHub, fine-grained, somente leitura de repos publicos.
# Sem token o limite e de 60 requisicoes/hora por IP.       [commit 41]
# GITHUB_TOKEN=
# GITHUB_USERNAME=

# Envio de e-mail do formulario de contato.                 [commit 47]
# RESEND_API_KEY=
# CONTACT_MAIL_TO=

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# URL publica do site. Base de canonical, OG e hreflang.    [commit 50]
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL interna da API. Nunca exposta ao navegador - sem o prefixo NEXT_PUBLIC_,
# o Next nao a embute no bundle, e o modulo que a le e marcado com server-only.
#
# Validada com Zod na primeira importacao (apps/web/src/lib/env.ts): ausente ou
# malformada, a aplicacao nao sobe. O erro aparece no deploy, com o nome da
# variavel, em vez de virar "fetch failed" em producao.
#
# O Next le este valor de apps/web/.env.local no desenvolvimento.
API_URL=http://localhost:8080

# Antispam do formulario. A site key e publica por design;
# a secret key jamais recebe o prefixo NEXT_PUBLIC_.        [commit 49]
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
