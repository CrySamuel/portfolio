{
  "openapi": "3.1.0",
  "info": {
    "title": "Portfolio API",
    "description": "API que serve o conteudo do portfolio de Crystofer Demetino.\n\nO site nao chama estes endpoints do navegador: quem chama e o BFF do Next.js, em build time e na revalidacao do ISR (ADR-0005). Por isso as respostas trazem Cache-Control generoso - o visitante recebe HTML da CDN e nunca espera pela API.",
    "contact": {
      "name": "Crystofer Demetino"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "0.0.1-SNAPSHOT"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Experience",
      "description": "Timeline profissional do dono do portfolio"
    },
    {
      "name": "Profile",
      "description": "Dados publicos do dono do portfolio"
    },
    {
      "name": "Skill",
      "description": "Competencias tecnicas agrupadas por categoria"
    }
  ],
  "paths": {
    "/api/v1/skills": {
      "get": {
        "tags": ["Skill"],
        "summary": "Lista as competencias agrupadas por categoria",
        "description": "Categorias em ordem editorial; dentro de cada uma, competencias do maior nivel para o menor. Categoria sem competencia nao aparece.",
        "operationId": "listSkills",
        "responses": {
          "200": {
            "description": "Catalogo, possivelmente vazio",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SkillCategory"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "tags": ["Profile"],
        "summary": "Devolve o perfil publico",
        "description": "Nome, headline, bio, disponibilidade e perfis externos, em ordem de exibicao.",
        "operationId": "getProfile",
        "responses": {
          "200": {
            "description": "Perfil encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "404": {
            "description": "Nenhum perfil cadastrado - o seed nao foi aplicado"
          }
        }
      }
    },
    "/api/v1/experiences": {
      "get": {
        "tags": ["Experience"],
        "summary": "Lista a timeline profissional",
        "description": "Passagens em ordem cronologica decrescente. Data de saida nula significa cargo atual.",
        "operationId": "listExperiences",
        "responses": {
          "200": {
            "description": "Timeline, possivelmente vazia",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Experience"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Skill": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Java"
          },
          "proficiency": {
            "type": "string",
            "enum": ["basic", "intermediate", "advanced"],
            "example": "advanced"
          },
          "yearsOfExperience": {
            "type": ["integer", "null"],
            "format": "int32",
            "example": 3
          }
        },
        "required": ["name", "proficiency", "yearsOfExperience"]
      },
      "SkillCategory": {
        "type": "object",
        "description": "Competencias agrupadas por categoria",
        "properties": {
          "name": {
            "type": "string",
            "example": "Linguagens & Frameworks"
          },
          "skills": {
            "type": "array",
            "description": "Competencias do grupo, da mais dominada para a menos",
            "items": {
              "$ref": "#/components/schemas/Skill"
            }
          }
        },
        "required": ["name", "skills"]
      },
      "Profile": {
        "type": "object",
        "description": "Perfil publico do portfolio",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Crystofer Demetino"
          },
          "headline": {
            "type": "string",
            "example": "Desenvolvedor Backend — Java & Spring Boot"
          },
          "bio": {
            "type": "string"
          },
          "location": {
            "type": ["string", "null"],
            "example": "Remoto · Brasil"
          },
          "resumeUrl": {
            "type": ["string", "null"]
          },
          "availableForWork": {
            "type": "boolean"
          },
          "socialLinks": {
            "type": "array",
            "description": "Perfis externos, ja em ordem de exibicao",
            "items": {
              "$ref": "#/components/schemas/SocialLink"
            }
          }
        },
        "required": [
          "availableForWork",
          "bio",
          "fullName",
          "headline",
          "location",
          "resumeUrl",
          "socialLinks"
        ]
      },
      "SocialLink": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["github", "linkedin", "email"],
            "example": "github"
          },
          "url": {
            "type": "string",
            "example": "https://github.com/CrySamuel"
          }
        },
        "required": ["platform", "url"]
      },
      "Experience": {
        "type": "object",
        "description": "Uma passagem profissional da timeline",
        "properties": {
          "company": {
            "type": "string",
            "example": "Acme"
          },
          "role": {
            "type": "string",
            "example": "Desenvolvedor Backend"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "example": "2022-03-01"
          },
          "endDate": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Nulo significa cargo atual",
            "example": "2024-01-31"
          },
          "description": {
            "type": "string"
          },
          "highlights": {
            "type": "array",
            "description": "Destaques da posicao; lista vazia quando nao ha",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["company", "description", "endDate", "highlights", "role", "startDate"]
      }
    }
  }
}
